rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'twagdy067@gmail.com';
    }
    match /gallery/{itemId} { allow read: if true; allow write: if isAdmin(); }
    match /gallery_order/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /before_after/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /deleted_static_images/{imageId} { allow read: if true; allow write: if isAdmin(); }
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'service', 'city', 'message', 'createdAt', 'status', 'privacyConsent', 'landingPage'
        ]) && request.resource.data.keys().hasAll([
          'name', 'phone', 'service', 'city', 'message', 'createdAt', 'status', 'privacyConsent', 'landingPage'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500
        && request.resource.data['service'] in [
          'برجولة حديقة وفلل', 'برجولة روف وأسطح', 'سقف ديكوري وتجاليد حوائط',
          'أعمال خشبية وبوابات مخصصة', 'صيانة وتجديد برجولة قديمة'
        ]
        && request.resource.data.landingPage in ['home', 'roof', 'garden']
        && request.resource.data.status == 'new'
        && request.resource.data.privacyConsent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /activity_log/{logId} { allow read, write: if isAdmin(); }
    // Server rate-limit documents and any unknown collection remain private.
    match /{document=**} { allow read, write: if false; }
  }
}
