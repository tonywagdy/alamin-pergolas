rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                     request.auth.token.email == "twagdy067@gmail.com";
    }
    match /before_after/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                     request.auth.token.email == "twagdy067@gmail.com";
    }
  }
}
